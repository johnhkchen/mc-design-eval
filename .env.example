# mc-design-eval secrets — copy to .env (gitignored) and fill in.
# The image→3D→voxel pipeline (E-09) needs these two; trials still run the
# LLM via the `claude -p` subscription shim, which needs NO key here.

# Nano Banana (Gemini) image generation — turns the LLM's design intent into a
# concept-art image. A Google AI Studio / Gemini API key (starts "AIza…").
# Shared with plant-model-studio.
GEMINI_API_KEY=

# Deployed TRELLIS 2 image→3D endpoint on Modal — the URL itself is the
# credential, so treat it as a secret. From plant-model-studio:
#   modal deploy scripts/trellis_modal.py   # prints the endpoint URL
MODAL_ENDPOINT_URL=
