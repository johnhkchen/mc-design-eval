{
  "id": "tauren",
  "name": "Tauren plains village",
  "faction": "Horde",
  "status": "draft",
  "concept": {
    "setting": "a tauren village on golden rolling grassland under a vast open sky, gentle hills and mesas on the horizon, warm late-afternoon light, smoke rising from cookfires",
    "buildings": "large conical and domed tents and round longhouses of painted hide stretched over thick log frames, the frame poles crossing and sticking out at the peak, hides painted with bold geometric bands and zigzags, broad low doorways with hide flaps, wooden decks and ramps on stout posts, carved wooden totems at the corners, feathers, horns and bone trim, everything big, sturdy and rounded to suit huge folk",
    "landmark": "a great tall totem pole of stacked carved animal heads with painted wings spread at the top, beside a wind-rider tower: a tall wooden lookout with a round hide-roofed platform and roosts for winged mounts",
    "street_life": "cookfires and drying racks, kodo beast pens with log fences, woven baskets and clay pots, drums, hide banners on tall poles, stone circles, totems along a wide dirt path",
    "greenery": "tall golden grass and scattered wildflowers, a few lone trees, hay bales",
    "materials": "spruce and oak logs for frames and totems, oak and birch planks for decks, white, yellow, orange-brown and brown wool and terracotta for painted hide, red and light blue accents in the painted bands, bone blocks and bone trim, hay bales, mud bricks and packed mud for hearths, campfires, lanterns",
    "colours": [
      "cream hide",
      "ochre",
      "earth red",
      "turquoise",
      "log brown"
    ],
    "avoid": [
      "square boxy houses",
      "stone castles",
      "bright saturated rainbow colours",
      "thin spindly frames"
    ],
    "ground": "golden grass and a wide dirt path"
  },
  "build": {
    "shell": null,
    "roles": null,
    "earthworks": null,
    "bridge": null,
    "harbour": null,
    "founding": null
  },
  "assets": {
    "tavern": {
      "storeys": 1,
      "what": "the village's great lodge (its tavern): one big single-storey hall under a broad hide roof, a long feast table and casks round a central hearth, three small sleeping alcoves for guests each opening off the hall, a hide banner over the door"
    },
    "workshop_smith": {
      "storeys": 1,
      "what": "a smith's forge tent and home: an open-fronted forge under a hide awning with anvil, quench trough and the smith's job blocks, joined at the back to a closed round sleeping tent with its own door and two beds"
    }
  },
  "factions": {
    "about": "Clans of one race, the same contract as orc, dwarf, goblin and night elf: one canonical palette per clan, the swaps from the authored base; the land chooses which clan settles where (styles/settlement.json). Each clan's `swaps` is its palette expanded to plain block ids for 1.21.1 (generated by src/styles/expand.mjs: read these, not the palette).",
    "base": "the authored base materials (tauren parts are built in these and nothing else for frames, hides and trim): spruce logs, wood and planks (and forms) for frames, poles, decks, ramps and totems; terracotta for the painted hide: white_terracotta (cream), yellow_terracotta (ochre), brown_terracotta, red_terracotta for bands and cyan_terracotta for turquoise accents, with matching wool, carpet and banners only as small accents; bone_block for horns, tusks and skulls; hay_block; mud_bricks (and forms) and packed_mud for hearths and footings; campfires and lanterns; the yard surface red_sand and dead_bush (markers the placer swaps for the land's ground and plant)",
