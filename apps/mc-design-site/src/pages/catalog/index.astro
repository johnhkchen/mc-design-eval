---
import Base from "../../layouts/Base.astro";
import CatalogGrid from "../../components/CatalogGrid.svelte";
import catalog from "../../data/catalog.json";
---
<Base title="Catalog" description="Buildings for Minecraft 1.21.1, each fitted to a standard plot, with 3-D views and schematics to download.">
  <section class="wrap section">
    <span class="eyebrow">The catalog</span>
    <h1>Buildings</h1>
    <p class="muted">Every building here has been approved and built on a real server. Each sits on a standard plot with its door to the street, ready to drop into a town. Open one to turn it in 3-D, watch a schematicannon place it, or download the schematic.</p>
    <CatalogGrid client:load entries={catalog} />
  </section>
</Base>
