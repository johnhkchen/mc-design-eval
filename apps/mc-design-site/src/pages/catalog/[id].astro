---
import { SEC_PER_BLOCK, cannonMinutes } from "../../data/cannon.js";
import Base from "../../layouts/Base.astro";
import Viewer3D from "../../components/Viewer3D.svelte";
import catalog from "../../data/catalog.json";
import { projectById } from "../../data/projects.js";
export function getStaticPaths() { return catalog.map((e) => ({ params: { id: e.id }, props: { e } })); }
const { e } = Astro.props;
const project = projectById[e.project];
const minutes = cannonMinutes(e.blocks);
---
<Base title={e.name} description={`${e.name}: a ${e.style.toLowerCase()} building for Minecraft ${e.version}, on a ${e.footprint.join(" × ")} plot.`}>
  <section class="wrap section detail">
    <div class="view"><Viewer3D client:visible src={e.nbt} poster={e.image} label={e.name} cannon /></div>
    <div class="info">
      <a class="muted back" href="/catalog/">← Catalog</a>
      <span class="eyebrow"><span class="no">No. {e.id.split("-")[1]}</span> · {e.type} · {e.style}</span>
      <h1>{e.name}</h1>
      <dl>
        <dt>Plot</dt><dd class="mono">{e.footprint.join(" × ")} blocks, {e.height} high</dd>
        <dt>Door</dt><dd>Faces the street (north in the file)</dd>
        <dt>Blocks</dt><dd class="mono">{e.blocks.toLocaleString()}</dd>
        <dt>Cannon time</dt><dd class="mono">about {minutes} min at {SEC_PER_BLOCK} s a block</dd>
        <dt>Version</dt><dd class="mono">Minecraft {e.version}</dd>
        {project && <><dt>Built in</dt><dd><a href={`/projects/${project.id}/`}>{project.code} {project.name}</a>, {project.town}</dd></>}
      </dl>
      <h3>Main materials</h3>
      <ul class="mats">{e.materials.map((m) => <li><span class="mono">{m.n.toLocaleString()}</span> {m.block.replace(/_/g, " ")}</li>)}</ul>
      <a class="btn" href={e.nbt} download>Download the schematic (.nbt)</a>
      <p class="muted small">Paste with Create's schematicannon using "Replace Solid with Solid". It carries no air, so it won't remove anything already there.</p>
    </div>
  </section>
</Base>
<style>
  .detail { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 40px; align-items: start; }
  @media (max-width: 900px) { .detail { grid-template-columns: minmax(0, 1fr); } }
  .view { min-width: 0; }
  .info { display: grid; gap: 14px; }
  .back { text-decoration: none; font-size: .9rem; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px; margin: 0; }
  dt { color: var(--ink-soft); font-size: .9rem; }
  dd { margin: 0; }
  .mats { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 16px; font-size: .92rem; }
  .small { font-size: .85rem; }
</style>
