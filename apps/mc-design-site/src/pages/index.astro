---
import Base from "../layouts/Base.astro";
import CatalogCard from "../components/CatalogCard.svelte";
import Scrubber3D from "../components/Scrubber3D.svelte";
import catalog from "../data/catalog.json";
import { projects } from "../data/projects.js";
const p = projects[0];
const blocks = catalog.reduce((n, e) => n + e.blocks, 0);
const facts = [[catalog.length, "buildings in the catalog"], [projects.length, "projects in Dragonholde"], [blocks.toLocaleString("en-US"), "blocks in the catalog"], ["1.21.1", "Minecraft version"]];
---
<Base>
  <section class="wrap hero">
    <div class="pitch">
      <span class="eyebrow">Minecraft towns, made to fit the land</span>
      <h1>Send us your land. Get back a town you can build.</h1>
      <p>Each town is designed around the hills, water and trees of the land you send us. You get schematics that a schematicannon pastes in survival, with world coordinates and the materials list.</p>
      <div class="cta"><a class="btn" href="/catalog/">Browse the catalog</a><a class="btn ghost" href="/projects/dh-01/">See a town come together</a></div>
    </div>
    <div class="show">
      <Scrubber3D client:visible before={p.before} after={p.after} poster={p.poster} label="Polarton" beforeLabel="The land" afterLabel="The town" />
      <p class="muted cap">{p.code} {p.name}, for Antipolar in Dragonholde.</p>
    </div>
  </section>

  <section class="wrap">
    <dl class="facts">
      {facts.map(([v, k]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
  </section>

  <section class="wrap section points">
    <div><span class="no">I.</span><h3>Fits your land</h3><p class="muted">Streets follow the contours, every plot gets a levelled pad and retaining walls, and nothing floats or blocks a door.</p></div>
    <div><span class="no">II.</span><h3>Builds in survival</h3><p class="muted">No creative paste, no admin needed. Each file comes with its world corner, its paste mode and a materials list for loading the cannon.</p></div>
    <div><span class="no">III.</span><h3>A catalog that grows</h3><p class="muted">Every building we approve joins the catalog, and new towns are drawn from it.</p></div>
  </section>

  <div class="wrap"><hr class="rule" /></div>
  <section class="wrap section">
    <div class="head"><h2>From the catalog</h2><a href="/catalog/">All {catalog.length} buildings →</a></div>
    <div class="cards">
      {catalog.slice(0, 4).map((e) => (
        <CatalogCard e={e} />
      ))}
    </div>
  </section>

  <div class="wrap"><hr class="rule" /></div>
  <section class="wrap section">
    <div class="head"><h2>Projects</h2><span class="muted">Both for Antipolar, in Dragonholde</span></div>
    <div class="projects">
      {projects.map((q) => (
        <a class="card" href={`/projects/${q.id}/`}>
          <div class="thumb wide"><img src={q.poster} alt={`${q.code} ${q.name || ""}`} loading="lazy" /></div>
          <span class="eyebrow">{q.code} · {q.status} · for {q.client}</span>
          <h3>{q.name || "Swamp reclamation"}</h3>
          <p class="muted">{q.lede}</p>
        </a>
      ))}
    </div>
  </section>

  <div class="wrap"><hr class="rule" /></div>
  <section class="wrap section soon">
    <div class="pitch"><span class="eyebrow">Coming</span><h2>Upload your own land</h2></div>
    <ol>
      <li><h3>Survey</h3><p class="muted">Upload an export and see your land mapped: water, slopes, trees, and where you can build.</p></li>
      <li><h3>Plan</h3><p class="muted">Roads, plots and earthworks laid over your land.</p></li>
      <li><h3>Town</h3><p class="muted">A terraformed, populated town from the catalog, cut into cannon files for however many cannons you run.</p></li>
    </ol>
  </section>
</Base>
<style>
  .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 40px; align-items: center; padding-block: 48px 24px; }
  @media (max-width: 900px) { .hero { grid-template-columns: minmax(0, 1fr); } }
  .pitch { display: grid; gap: 18px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .show { display: grid; gap: 8px; min-width: 0; }
  .cap { font-size: .88rem; }
  .points { grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 28px; }
  .points div { display: grid; gap: 6px; align-content: start; }
  .head { display: flex; flex-wrap: wrap; gap: 8px; justify-content: space-between; align-items: baseline; }
  .projects { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 32px; }
  .thumb.wide { aspect-ratio: 16 / 10; }
  .facts { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--rule); }
  .facts div { padding: 16px 20px 18px; display: grid; gap: 4px; align-content: start; }
  .facts div + div { border-left: 1px solid var(--rule); }
  .facts dt { font: 600 .72rem/1.3 var(--body); text-transform: uppercase; letter-spacing: .12em; color: var(--ink-soft); }
  .facts dd { margin: 0; font: 600 1.7rem/1.1 var(--display); font-variant-numeric: tabular-nums; order: -1; }
  @media (max-width: 700px) { .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } .facts div:nth-child(3) { border-left: 0; } .facts div:nth-child(n+3) { border-top: 1px solid var(--rule); } .facts div { padding-inline: 12px; } }
  .points .no { font-size: 1rem; }
  .soon ol { margin: 0; padding: 0; list-style: none; counter-reset: step; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 28px; }
  .soon li { counter-increment: step; display: grid; gap: 6px; align-content: start; border-top: 2px solid var(--ink); padding-top: 12px; }
  .soon li::before { content: counter(step); font: 700 2rem/1 var(--display); color: var(--mark); }
</style>
