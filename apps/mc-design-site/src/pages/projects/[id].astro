---
import Base from "../../layouts/Base.astro";
import CatalogCard from "../../components/CatalogCard.svelte";
import Scrubber3D from "../../components/Scrubber3D.svelte";
import catalog from "../../data/catalog.json";
import { projects } from "../../data/projects.js";
export function getStaticPaths() { return projects.map((p) => ({ params: { id: p.id }, props: { p } })); }
const { p } = Astro.props;
const title = `${p.code} ${p.name || "Swamp reclamation"}`;
const mods = catalog.filter((e) => p.modules.includes(e.id));
---
<Base title={title} description={p.lede}>
  <section class="wrap section">
    <nav class="tabs" aria-label="Projects">{projects.map((q) => <a href={`/projects/${q.id}/`} aria-current={q.id === p.id ? "page" : undefined}>{q.code}</a>)}</nav>
    <span class="eyebrow">{p.code} · {p.status} · {p.client ? `for ${p.client} in ${p.town}` : p.where} · {p.size}</span>
    <h1>{p.name || "Swamp reclamation"}{p.placeholder && <span class="muted ph"> (working name)</span>}</h1>
    <p class="lede">{p.lede}</p>
    <Scrubber3D client:visible before={p.before} after={p.after} poster={p.poster} label={title} beforeLabel={p.beforeLabel ?? "Before"} afterLabel={p.afterLabel ?? (p.status === "Built" ? "Built" : "Planned")} />
  </section>
  <section class="wrap section story">
    {p.story.map(([h, t]) => <div><h3>{h}</h3><p>{t}</p></div>)}
  </section>
  {p.plan && (
    <section class="wrap section">
      <figure class="plan">
        <img src={p.plan} alt={`Plan of ${title}`} loading="lazy" width="1200" height="1200" />
        <figcaption><span class="eyebrow">The plan</span><p class="muted">{p.planCaption}</p></figcaption>
      </figure>
    </section>
  )}
  {mods.length > 0 && (
    <section class="wrap section">
      <h2>The buildings</h2>
      <div class="cards">
        {mods.map((e) => (
          <CatalogCard e={e} />
        ))}
      </div>
    </section>
  )}
  {p.credits && (
    <section class="wrap section"><h2 class="credits-h">Sources and credits</h2><ul class="credits">{p.credits.map((c) => <li>{c}</li>)}</ul></section>
  )}
  {p.client && <section class="wrap section"><p class="muted">The cannon jobs for this project are on the <a href="/board/">construction board</a>.</p></section>}
</Base>
<style>
  .tabs { display: flex; gap: 6px; }
  .tabs a { font: 600 .85rem/1 var(--body); padding: 7px 11px; border: 1px solid var(--rule); border-radius: 3px; text-decoration: none; color: var(--ink); }
  .tabs a[aria-current="page"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .ph { font-size: .5em; font-weight: 500; }
  .lede { font-size: 1.15rem; }
  .story { grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 28px; padding-top: 8px; }
  .plan { margin: 0; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 28px; align-items: end; }
  .plan img { width: 100%; height: auto; border-radius: 4px; image-rendering: pixelated; }
  .plan figcaption { display: grid; gap: 8px; }
  @media (max-width: 800px) { .plan { grid-template-columns: minmax(0, 1fr); } }
  .credits-h { font-size: 1.2rem; }
  .credits { margin: 0; padding-left: 1.2em; display: grid; gap: 4px; color: var(--ink-soft); font-size: .9rem; }
  .story div { display: grid; gap: 8px; align-content: start; }
</style>
