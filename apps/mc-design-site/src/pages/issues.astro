---
import Base from "../layouts/Base.astro";
import IssuesBoard from "../components/IssuesBoard.svelte";
import catalog from "../data/catalog.json";
---
<Base title="Issues" description="What the checks found in each catalog building, fixed by code where it can be, and studied by kind where it can't.">
  <section class="wrap section">
    <span class="eyebrow">Fix system</span>
    <h1>Issues</h1>
    <p class="muted">Every catalog building goes through the same checks: how things sit, whether every room can be reached and is lit, and whether the walk from the street to the door meets the accessible standard. What code can repair gets a button. What it can't is tagged, and each kind is studied across every build that came out that way, so the recipe gets fixed, not just the building.</p>
    <IssuesBoard client:load catalog={catalog.map(({ id, name, image, variantOf, series }) => ({ id, name, image, variantOf, series }))} />
  </section>
</Base>
