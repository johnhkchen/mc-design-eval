node_modules/
*.log
.DS_Store

# Secrets — never commit (provisioned locally; see .env.example for the names)
.env
.env.local

# Generated per-trial store (artifacts, transcripts, records) — T-004-01
trials/

# BAML generated client (regenerate with: npm run baml:gen)
baml_client/

# Benchmark renders/artifacts — reproducible per-run outputs; the durable record is the
# journal (docs/knowledge/design-learnings.md). Renders are local-only (image-heavy).
benchmarks/temple-facade/runs/

# Stage-1 concept-art outputs (E-09) — reproducible, local-only
benchmarks/temple-facade/concepts/

# TRELLIS GLB binaries (E-09 stage-2) — ~5 MB each, regenerable from concept.png via
# benchmarks/sculpture/trellis-glb.mjs; the durable record is glb/README.md (the manifest).
benchmarks/sculpture/glb/*.glb

# GLB silhouette sanity renders (T-048-01) — derived from the gitignored GLBs, regen via
# `node src/form/glb-silhouette.mjs benchmarks/sculpture/glb/<name>.glb`.
benchmarks/sculpture/glb/silhouette/

# GLB-voxel build renders (T-051-01) — image-heavy, derived from the gitignored GLBs, regen via
# `node benchmarks/sculpture/glb-voxel-run.mjs`. The durable record is summary.md + artifact.json.
benchmarks/sculpture/glb-voxel/**/render-3q.png

# GLB-voxel surgical-loop renders (T-052-01) — image-heavy, derived, regen via
# `node benchmarks/sculpture/glb-voxel-surgical.mjs`. The durable record is the .json/.md summary.
benchmarks/sculpture/glb-voxel-surgical/**/*.png

# GLB-voxel material-clean (R2) renders (T-055-01) — image-heavy, derived, regen via
# `node benchmarks/sculpture/glb-voxel-clean.mjs`. The durable record is summary.json + r2.{md,json}.
benchmarks/sculpture/glb-voxel-clean/**/render-3q.png

# GLB-voxel surgical SWEEP renders (T-056-01, E-17 R3) — derived, regen via
# `node benchmarks/sculpture/glb-voxel-surgical-sweep.mjs`. Durable record: r3.{md,json} + summaries.
benchmarks/sculpture/glb-voxel-surgical-sweep/**/*.png

# Ablation collector R0 renders (T-056-01, E-17) — derived. Durable record: sweep-ablation.{md,json}.
benchmarks/sculpture/sweep-ablation/**/*.png

# Thin-voxel before/after renders (T-059-01, E-18) — image-heavy, derived from the gitignored GLBs,
# regen via `node benchmarks/sculpture/glb-voxel-thin.mjs`. Durable record: thin.{md,json} + summaries.
benchmarks/sculpture/glb-voxel-thin/**/render-*.png

# Material-region segmentation renders (T-058-01, E-18) — derived, regen via
# `node benchmarks/sculpture/glb-voxel-seg.mjs`. Durable record: seg.{md,json} + per-subject summaries.
benchmarks/sculpture/glb-voxel-seg/**/render-3q.png

# E-18 combined remeasure renders (T-060-01) — derived, regen via
# `node benchmarks/sculpture/e18-remeasure.mjs`. Durable record: e18-remeasure.{md,json} + per-subject summaries.
benchmarks/sculpture/e18-build/**/render-3q.png

# E-18 gated secondary palette renders (T-058-03) — derived, regen via
# `node benchmarks/sculpture/secondary-palette.mjs`. Durable record: secondary-palette.{md,json} + per-subject summaries.
benchmarks/sculpture/secondary-palette/**/render-3q.png

# E-21 feature-aware-assignment renders (T-072-01) — derived from the gitignored gatehouse GLB, regen via
# `node benchmarks/sculpture/material-assign.mjs`. Durable record: material-assign/<subj>.json + artifact.json.
benchmarks/sculpture/material-assign/**/render-3q.png

# E-21 concept material-correction renders (T-073-01) — region crops + before/after, regen via
# `node benchmarks/sculpture/material-correct.mjs`. Durable record: material-correct/<subj>.{json,md} + artifact.json.
benchmarks/sculpture/material-correct/**/*.png

# E-21 concept-materials A/B renders (T-074-01) — before/after PNGs, regen via `node benchmarks/sculpture/
# concept-materials-ab.mjs`. Durable record: concept-materials-ab.{json,md} + concept-materials/<subj>/*-artifact.json.
benchmarks/sculpture/concept-materials/**/*.png

# E-20 high-res building build renders (T-068-01) — per-scale 3q renders, regen via `node benchmarks/
# sculpture/building-build.mjs`. Durable record: building-build.{json,md} + building/scale-<n>/{artifact,summary}.json
# + building/best/artifact.json. The chosen frame pr/assets/frames/building-best.png is committed (a frame).
benchmarks/sculpture/building/**/*.png
# per-scale intermediate artifacts are large + regenerable; commit the lightweight summary + the chosen
# building/best/artifact.json (the deliverable) only.
benchmarks/sculpture/building/scale-*/artifact.json

# E-20 surgical refine-to-standard (T-069-01) — the refined build is byte-identical to building/best/
# (the loop accepted zero edits; the cage held), so the 7.6 MB duplicate is NOT re-committed. Durable record:
# surgical-standard.{json,md} + building/round-*/summary.json. Regenerate via `npm run surgical:standard`.
benchmarks/sculpture/building/refined/artifact.json

# Spray-paint face renders (T-079-01, E-23) — derived, regen via `npm run spray:paint`. The durable
# record is spray-paint/cottage.{json,md} + spray-paint/cottage/artifact.json (the painted build).
# EXCEPTION: the oblique before/after pair IS the committed T-090-01 acceptance evidence (E-25 Rule 1:
# the render is the evidence) — un-ignored by name.
benchmarks/sculpture/spray-paint/**/*.png
!benchmarks/sculpture/spray-paint/cottage/view-oblique135-before.png
!benchmarks/sculpture/spray-paint/cottage/view-oblique135-after.png

# Value-true selection renders (T-086-01) — derived, image-heavy; the durable record is
# value-select/cottage.{json,md} + value-select/cottage/artifact.json (the recolored build).
benchmarks/sculpture/value-select/**/*.png

# Surface-pattern renders (T-087-01) — derived, regen via `npm run pattern:cottage`. The durable
# record is surface-pattern/cottage.{json,md} + surface-pattern/cottage/artifact.json (the patterned build).
benchmarks/sculpture/surface-pattern/**/*.png

# Durable-skin renders (T-089-01, E-24 consolidation) — derived, regen via `npm run skin:<subject>`.
# The durable record is durable-skin/<subj>.{json,md} + durable-skin/<subj>/artifact.json; the
# committed evidence frames live in pr/assets/frames/durable-*.png.
benchmarks/sculpture/durable-skin/**/*.png
