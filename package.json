{
  "name": "mc-design-eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LLM-driven Minecraft design evaluation stack",
  "scripts": {
    "validate": "node scripts/validate-artifact.mjs",
    "validate:good": "node scripts/validate-artifact.mjs --expect valid schema/examples/valid-industrial-house.json",
    "validate:bad": "node scripts/validate-artifact.mjs --expect invalid schema/examples/invalid-industrial-house.json",
    "test:unit": "node --test \"src/**/*.test.mjs\"",
    "pack:validate": "node scripts/validate-pack.mjs packs/rustic.json",
    "idioms:card": "node benchmarks/sculpture/idiom-card.mjs",
    "render:beside": "node benchmarks/sculpture/render-beside.mjs",
    "brush:catalog": "node benchmarks/sculpture/brush-catalog.mjs",
    "workshop:fixture": "node benchmarks/sculpture/workshop.mjs --subject fixture",
    "workshop:replay": "node benchmarks/sculpture/workshop.mjs --subject fixture --replay",
    "workshop:offline": "node benchmarks/sculpture/workshop.mjs --subject fixture --offline",
    "levers:cottage": "node benchmarks/sculpture/geometry-levers.mjs --subject cottage",
    "levers:cottage:replay": "node benchmarks/sculpture/geometry-levers.mjs --subject cottage --replay",
    "levers:cottage:offline": "node benchmarks/sculpture/geometry-levers.mjs --subject cottage --offline",
    "levers:barn": "node benchmarks/sculpture/geometry-levers.mjs --subject barn",
    "trial:run": "node scripts/run-trial.mjs",
    "smoke:run": "node scripts/run-trial.mjs",
    "trial:iterative": "node scripts/run-iterative-trial.mjs",
    "bench:temple-facade": "node benchmarks/temple-facade/run.mjs",
    "bench:sculpture": "node benchmarks/sculpture/run.mjs",
    "bench:building": "node benchmarks/sculpture/run.mjs --mode building",
    "bench:judge": "node benchmarks/temple-facade/judge-runs.mjs",
    "spray:paint": "node benchmarks/sculpture/spray-paint.mjs",
    "skin:cottage": "node benchmarks/sculpture/durable-skin.mjs --subject cottage",
    "skin:gatehouse": "node benchmarks/sculpture/durable-skin.mjs --subject gatehouse",
    "zone:map": "node benchmarks/sculpture/zone-map.mjs",
    "registration:smoke": "node benchmarks/sculpture/registration-smoke.mjs",
    "gate:multi": "node benchmarks/sculpture/multi-angle-gate.mjs",
    "diff:roof": "node benchmarks/sculpture/roof-diff.mjs",
    "gate:rejudge": "node benchmarks/sculpture/multi-angle-gate.mjs --rejudge",
    "gate:calibrate": "node benchmarks/sculpture/budget-calibration.mjs",
    "relief:calibrate": "node benchmarks/sculpture/relief-calibration.mjs",
    "grammar:cottage": "node benchmarks/sculpture/placement-grammar.mjs --subject cottage",
    "grammar:gatehouse": "node benchmarks/sculpture/placement-grammar.mjs --subject gatehouse",
    "pattern:cottage": "node benchmarks/sculpture/surface-pattern.mjs",
    "shell:cottage": "node benchmarks/sculpture/shell-integrity.mjs --subject cottage",
    "shell:gatehouse": "node benchmarks/sculpture/shell-integrity.mjs --subject gatehouse",
    "kit:extract": "node benchmarks/sculpture/kit-extract.mjs",
    "card:fixtures": "node benchmarks/sculpture/fixture-card.mjs",
    "dress:cottage": "node benchmarks/sculpture/dress-openings.mjs --subject cottage",
    "build:block-vocab": "node scripts/build-block-vocab.mjs",
    "build:block-table": "node scripts/build-block-table.mjs",
    "palette:extract": "node scripts/extract-palette.mjs",
    "grid:build": "node scripts/image-to-grid.mjs",
    "pretest": "npm run baml:gen",
    "test": "node scripts/validate-artifact.mjs --self-test --expect valid schema/examples/valid-industrial-house.json && node scripts/validate-artifact.mjs --expect invalid schema/examples/invalid-industrial-house.json && npm run test:unit",
    "baml:gen": "baml-cli generate --from baml_src",
    "baml:mint": "node scripts/mint-baml-fixture.mjs",
    "backlog:generate": "node scripts/design-backlog.mjs",
    "presence:cottage": "node benchmarks/sculpture/kit-presence.mjs --subject cottage",
    "components:cottage": "node benchmarks/sculpture/component-decomposition.mjs --subject cottage",
    "components:gatehouse": "node benchmarks/sculpture/component-decomposition.mjs --subject gatehouse",
    "components:church": "node benchmarks/sculpture/component-decomposition.mjs --subject church",
    "shaped:cottage": "node benchmarks/sculpture/shaped-vocabulary.mjs --subject cottage",
    "shaped:gatehouse": "node benchmarks/sculpture/shaped-vocabulary.mjs --subject gatehouse",
    "shaped:church": "node benchmarks/sculpture/shaped-vocabulary.mjs --subject church",
    "roof:cottage": "node benchmarks/sculpture/roof-program.mjs --subject cottage",
    "roof:gatehouse": "node benchmarks/sculpture/roof-program.mjs --subject gatehouse",
    "roof:church": "node benchmarks/sculpture/roof-program.mjs --subject church",
    "reskin:cottage": "node benchmarks/sculpture/component-skin.mjs --subject cottage",
    "reskin:gatehouse": "node benchmarks/sculpture/component-skin.mjs --subject gatehouse",
    "reskin:church": "node benchmarks/sculpture/component-skin.mjs --subject church",
    "build:cottage": "node benchmarks/sculpture/build.mjs --subject cottage",
    "build:barn": "node benchmarks/sculpture/build.mjs --subject barn",
    "build:cottage:repro": "node benchmarks/sculpture/build.mjs --subject cottage --repro",
    "build:barn:repro": "node benchmarks/sculpture/build.mjs --subject barn --repro",
    "sketch:cottage": "node benchmarks/sculpture/form-sketch.mjs --subject cottage",
    "sketch:gatehouse": "node benchmarks/sculpture/form-sketch.mjs --subject gatehouse",
    "sketch:church": "node benchmarks/sculpture/form-sketch.mjs --subject church",
    "sketch:barn": "node benchmarks/sculpture/form-sketch.mjs --subject barn",
    "sketch:all": "node benchmarks/sculpture/form-sketch.mjs --all",
    "recognize:cottage": "node benchmarks/sculpture/recognize.mjs --subject cottage",
    "recognize:barn": "node benchmarks/sculpture/recognize.mjs --subject barn",
    "recognize:offline": "node benchmarks/sculpture/recognize.mjs --offline --all",
    "facade:cottage": "node benchmarks/sculpture/facade-grammar.mjs --subject cottage",
    "facade:barn": "node benchmarks/sculpture/facade-grammar.mjs --subject barn",
    "facade:offline": "node benchmarks/sculpture/facade-grammar.mjs --offline",
    "gate:patternbook:cottage": "node benchmarks/sculpture/multi-angle-gate.mjs --subject cottage --label patternbook --artifact workshop/cottage/final-artifact.json --reference recognition/cottage.artifact.json",
    "gate:patternbook:barn": "node benchmarks/sculpture/multi-angle-gate.mjs --subject barn --label patternbook --artifact workshop/barn/final-artifact.json --reference recognition/barn.artifact.json",
    "recognize:barn:saltcrag": "node benchmarks/sculpture/recognize.mjs --subject barn --pack packs/saltcrag.json --ticket T-132-01",
    "gate:patternbook:barn:saltcrag": "node benchmarks/sculpture/multi-angle-gate.mjs --subject barn --label patternbook-saltcrag --artifact workshop/barn--saltcrag/final-artifact.json --reference recognition/barn--saltcrag.artifact.json",
    "measured:cottage": "node benchmarks/sculpture/measured-proportions.mjs --subject cottage",
    "measured:barn": "node benchmarks/sculpture/measured-proportions.mjs --subject barn",
    "measured:barn:saltcrag": "node benchmarks/sculpture/measured-proportions.mjs --subject barn --pack packs/saltcrag.json --ticket T-138-01",
    "milestone:proportion": "node benchmarks/sculpture/proportion-milestone.mjs",
    "milestone:proportion:baselines": "node benchmarks/sculpture/proportion-milestone.mjs --baselines",
    "milestone:proportion:repro": "node benchmarks/sculpture/proportion-milestone.mjs --repro",
    "milestone:facade": "node benchmarks/sculpture/facade-milestone.mjs",
    "milestone:facade:baselines": "node benchmarks/sculpture/facade-milestone.mjs --baselines",
    "milestone:facade:repro": "node benchmarks/sculpture/facade-milestone.mjs --repro",
    "measured:repro": "node benchmarks/sculpture/measured-proportions.mjs --all --repro",
    "measured:offline": "node benchmarks/sculpture/measured-proportions.mjs --all --offline",
    "proportion:cottage": "node benchmarks/sculpture/proportion-witness.mjs --subject cottage",
    "proportion:barn": "node benchmarks/sculpture/proportion-witness.mjs --subject barn",
    "proportion:repro": "node benchmarks/sculpture/proportion-witness.mjs --all --repro",
    "ruler:calibrate": "node benchmarks/sculpture/ruler-calibration.mjs",
    "ruler:repro": "node benchmarks/sculpture/ruler-calibration.mjs --repro",
    "visibility:cottage": "node benchmarks/sculpture/visibility-witness.mjs --subject cottage --label patternbook",
    "visibility:all": "node benchmarks/sculpture/visibility-witness.mjs --all",
    "visibility:repro": "node benchmarks/sculpture/visibility-witness.mjs --all --repro",
    "steep:barn": "node benchmarks/sculpture/steep-pitch.mjs --subject barn",
    "steep:barn:saltcrag": "node benchmarks/sculpture/steep-pitch.mjs --subject barn --pack packs/saltcrag.json",
    "steep:repro": "node benchmarks/sculpture/steep-pitch.mjs --all --repro",
    "steep:offline": "node benchmarks/sculpture/steep-pitch.mjs --all --offline",
    "style:form": "node scripts/form-style.mjs",
    "style:ratify": "node scripts/ratify-pack.mjs",
    "factory:receipts": "node scripts/factory-receipts.mjs --style saltcrag",
    "lisa:claim": "node scripts/lisa-claim.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jpeg-js": "^0.4.4",
    "minecraft-assets": "^1.17.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.22.4"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.162"
  },
  "dependencies": {
    "@boundaryml/baml": "^0.222.0"
  }
}
