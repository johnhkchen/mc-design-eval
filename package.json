{
  "name": "mc-design-eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LLM-driven Minecraft design evaluation stack",
  "scripts": {
    "validate": "node scripts/validate-artifact.mjs",
    "validate:good": "node scripts/validate-artifact.mjs --expect valid schema/examples/valid-industrial-house.json",
    "validate:bad": "node scripts/validate-artifact.mjs --expect invalid schema/examples/invalid-industrial-house.json",
    "test:unit": "node --test \"src/**/*.test.mjs\"",
    "trial:run": "node scripts/run-trial.mjs",
    "smoke:run": "node scripts/run-trial.mjs",
    "trial:iterative": "node scripts/run-iterative-trial.mjs",
    "bench:temple-facade": "node benchmarks/temple-facade/run.mjs",
    "bench:sculpture": "node benchmarks/sculpture/run.mjs",
    "bench:building": "node benchmarks/sculpture/run.mjs --mode building",
    "bench:judge": "node benchmarks/temple-facade/judge-runs.mjs",
    "form:routing": "node benchmarks/sculpture/form-routing.mjs",
    "e19:build": "node benchmarks/sculpture/e19-build.mjs",
    "building:build": "node benchmarks/sculpture/building-build.mjs",
    "view:proof": "node benchmarks/sculpture/view-layer-proof.mjs",
    "spray:paint": "node benchmarks/sculpture/spray-paint.mjs",
    "skin:cottage": "node benchmarks/sculpture/durable-skin.mjs --subject cottage",
    "skin:gatehouse": "node benchmarks/sculpture/durable-skin.mjs --subject gatehouse",
    "pattern:cottage": "node benchmarks/sculpture/surface-pattern.mjs",
    "detect:routing": "node benchmarks/sculpture/detector-routing.mjs",
    "coherence:cottage": "node benchmarks/sculpture/surface-coherence.mjs",
    "hollow:cottage": "node benchmarks/sculpture/hollow-cottage.mjs",
    "floorplan:cottage": "node benchmarks/sculpture/floorplan-cottage.mjs",
    "milestone:cottage": "node benchmarks/sculpture/hollow-cottage-milestone.mjs",
    "resemblance": "node benchmarks/sculpture/resemblance.mjs",
    "resemblance:consolidate": "node benchmarks/sculpture/resemblance-consolidation.mjs",
    "surgical:standard": "node benchmarks/sculpture/surgical-standard.mjs",
    "material:map": "node benchmarks/sculpture/material-map.mjs",
    "material:assign": "node benchmarks/sculpture/material-assign.mjs",
    "material:correct": "node benchmarks/sculpture/material-correct.mjs",
    "value:select": "node benchmarks/sculpture/value-select.mjs",
    "concept:ab": "node benchmarks/sculpture/concept-materials-ab.mjs",
    "build:block-table": "node scripts/build-block-table.mjs",
    "palette:extract": "node scripts/extract-palette.mjs",
    "grid:build": "node scripts/image-to-grid.mjs",
    "test": "node scripts/validate-artifact.mjs --self-test --expect valid schema/examples/valid-industrial-house.json && node scripts/validate-artifact.mjs --expect invalid schema/examples/invalid-industrial-house.json && npm run test:unit",
    "baml:gen": "baml-cli generate --from baml_src"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jpeg-js": "^0.4.4",
    "minecraft-assets": "^1.17.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.22.4"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.162"
  },
  "dependencies": {
    "@boundaryml/baml": "^0.222.0"
  }
}
